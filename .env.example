# Public site URL used for canonical links, sitemap, RSS, and Open Graph tags.
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app

# Sanity CMS connection (safe to expose project ID + dataset).
NEXT_PUBLIC_SANITY_PROJECT_ID=your-sanity-project-id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-07-18

# Optional: your hosted Sanity Studio URL, for example https://scrawl-cms.sanity.studio
NEXT_PUBLIC_SANITY_STUDIO_URL=https://your-studio.sanity.studio
